<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="400.0" prefWidth="600.0" stylesheets="@../Style/checkout.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">
   <children>
      <VBox alignment="TOP_CENTER" prefWidth="430.0" spacing="18.0">
         <padding>
            <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
         </padding>
         <children>
            <Label styleClass="checkout-title" text="Checkout" textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="28.0" />
               </font>
            </Label>
            <VBox fx:id="cardBox" prefHeight="200.0" prefWidth="100.0" spacing="12.0" styleClass="card">
               <children>
                  <Label text="Indirizzo">
                     <font>
                        <Font name="System Bold" size="16.0" />
                     </font>
                     <padding>
                        <Insets top="5.0" />
                     </padding></Label>
                  <TextField promptText="Nome completo" styleClass="input" />
                  <TextField prefWidth="300.0" promptText="Via" styleClass="input" />
                  <TextField prefWidth="300.0" promptText="Città" styleClass="input" />
                  <HBox prefHeight="100.0" prefWidth="200.0" spacing="15.0" styleClass="row">
                     <children>
                        <TextField promptText="CAP" styleClass="input" />
                        <TextField prefWidth="140.0" promptText="Provincia" styleClass="input" />
                     </children>
                  </HBox>
                  <Separator prefWidth="200.0" styleClass="separator" />
               </children>
               <padding>
                  <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
               </padding>
            </VBox>
         </children>
      </VBox>
   </children>
</AnchorPane>
