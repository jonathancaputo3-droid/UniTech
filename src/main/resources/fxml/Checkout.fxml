                  </Label>

                              <TextField prefHeight="35.0" promptText="Nome completo" style="-fx-background-color: #f2f2f7; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 8 10 8 10;" styleClass="input" />
                  <TextField prefHeight="35.0" promptText="Via" style="-fx-background-color: #f2f2f7; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 8 10 8 10;" styleClass="input" />
                  <TextField prefHeight="35.0" promptText="Città" style="-fx-background-color: #f2f2f7; -fx-background-radius: 10; -fx-border-color: transparent; -fx-padding: 8 10 8 10;" styleClass="input" />

                              <HBox spacing="12.0" styleClass="row">
