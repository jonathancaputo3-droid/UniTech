            </Label>

                        <VBox fx:id="cardBox" maxWidth="420.0" minWidth="420.0" prefWidth="420.0" spacing="14.0" style="-fx-background-color: white; -fx-background-radius: 16; -fx-border-radius: 16; -fx-border-color: #e5e5ea; -fx-border-width: 1;" styleClass="elevated-2">

