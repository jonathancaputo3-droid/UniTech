<AnchorPane prefHeight="542.0" prefWidth="600.0" style="-fx-background-color: #f5f5f7;" stylesheets="@../Style/cupertino-light.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="CONTROLLER_NAME">

   <children>

