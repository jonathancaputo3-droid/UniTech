<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.Scene?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.stage.Stage?>

<Stage xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1">
    <scene>
        <Scene stylesheets="@cupertino-light.css">
            <AnchorPane prefHeight="1080.0" prefWidth="1920.0">
            <children>
               <HBox prefHeight="80.0" prefWidth="1920.0" style="-fx-border-color:: -color-accent-emphasis;">
                  <styleClass>
                     <String fx:value="bg-default" />
                     <String fx:value="border-default" />
                     <String fx:value="elevated-1" />
                  </styleClass>
               </HBox>
            </children></AnchorPane>
        </Scene>
    </scene>
</Stage>
